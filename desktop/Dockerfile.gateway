FROM node:24.19.0-bookworm-slim AS qualification
# Published CLI and all transitive artifacts are integrity-pinned in the lock.
# Operator diagnostics retain the CLI without an expired Windows ZIP dependency.
RUN apt-get update && apt-get install -y --no-install-recommends python3 ca-certificates && rm -rf /var/lib/apt/lists/*
COPY desktop/qualification-runtime/package.json desktop/qualification-runtime/package-lock.json /opt/velia-qualification/harness/
RUN npm ci --prefix /opt/velia-qualification/harness --ignore-scripts --no-audit --no-fund \
    && node /opt/velia-qualification/harness/node_modules/@deepseek-ai/dsh/lib/bin.js --version
COPY desktop/web/*.mjs /opt/velia-web/
COPY desktop/web/tests /opt/velia-web/tests
RUN node --check /opt/velia-web/app.mjs
RUN node --test /opt/velia-web/tests/*.test.mjs

FROM python:3.12-slim-bookworm AS checked
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/app
COPY desktop/requirements-gateway.txt /app/desktop/requirements-gateway.txt
RUN pip install --no-cache-dir -r desktop/requirements-gateway.txt pytest==8.4.2
COPY velia_free_models.py velia_desktop_routes.py velia_quantum_provider.py velia_quantum_turn.py velia_quantum_transport.py velia_quantum_groq_probe.py /app/
COPY velia_request_understanding.py /app/velia_request_understanding.py
COPY desktop/platform_status.py desktop/gateway.py desktop/admin_proxy.py desktop/probe_gateway.py desktop/probe_browser_agent_web.py desktop/probe_request_intent.py desktop/probe_quantum_independence.py desktop/quantum_intent.py desktop/answer_review.py desktop/web_routes.py desktop/feature_routes.py desktop/voice_routes.py desktop/work_store.py desktop/work_runtime.py desktop/work_routes.py desktop/upwork_connector.py desktop/account_routes.py desktop/guest_routes.py desktop/guest_store.py desktop/web_search.py desktop/request_intent.py desktop/direct_tasks.py desktop/decision_router.py desktop/spelling_hints.py desktop/flash_worker_start.py /app/desktop/
COPY desktop/background_agent.py /app/desktop/background_agent.py
COPY services/velia_structured_output.py /app/services/velia_structured_output.py
COPY desktop/probe_web_voice.py /app/desktop/probe_web_voice.py
COPY desktop/web /app/desktop/web
COPY tests/test_velia_quantum_provider.py tests/test_velia_quantum_transport.py tests/test_velia_quantum_gateway.py tests/test_velia_quantum_independence.py tests/test_velia_desktop_gateway.py tests/test_velia_desktop_relay.py tests/test_velia_desktop_flash.py tests/test_velia_web_chat.py tests/test_velia_web_guest.py tests/test_velia_web_search.py tests/test_velia_request_understanding.py tests/test_velia_request_intent.py tests/test_velia_intent_speed.py tests/test_velia_decision_router.py tests/test_velia_answer_review.py tests/test_velia_flash_worker_start.py tests/test_velia_desktop_flash_readiness.py tests/test_velia_admin_proxy.py tests/test_velia_web_features.py tests/test_velia_web_voice.py tests/test_velia_work.py tests/test_velia_upwork.py tests/test_velia_platform_status.py tests/test_velia_structured_output.py /app/tests/
RUN python -m pytest -q -p no:cacheprovider tests/test_velia_quantum_provider.py tests/test_velia_quantum_transport.py tests/test_velia_quantum_gateway.py tests/test_velia_quantum_independence.py tests/test_velia_desktop_gateway.py tests/test_velia_desktop_relay.py tests/test_velia_desktop_flash.py tests/test_velia_web_chat.py tests/test_velia_web_guest.py tests/test_velia_web_search.py tests/test_velia_request_understanding.py tests/test_velia_request_intent.py tests/test_velia_intent_speed.py tests/test_velia_decision_router.py tests/test_velia_answer_review.py tests/test_velia_flash_worker_start.py tests/test_velia_desktop_flash_readiness.py tests/test_velia_admin_proxy.py tests/test_velia_web_features.py tests/test_velia_web_voice.py tests/test_velia_work.py tests/test_velia_upwork.py tests/test_velia_platform_status.py tests/test_velia_structured_output.py

FROM python:3.12-slim-bookworm
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/app
COPY desktop/requirements-gateway.txt /app/desktop/requirements-gateway.txt
RUN apt-get update && apt-get install -y --no-install-recommends libstdc++6 && rm -rf /var/lib/apt/lists/* && pip install --no-cache-dir -r desktop/requirements-gateway.txt && useradd --system --uid 10001 velia
COPY --from=qualification /usr/local/bin/node /usr/local/bin/node
COPY --from=qualification /opt/velia-qualification /opt/velia-qualification
COPY --from=checked /app/velia_free_models.py /app/velia_desktop_routes.py /app/velia_quantum_provider.py /app/velia_quantum_turn.py /app/velia_quantum_transport.py /app/velia_quantum_groq_probe.py /app/
COPY --from=checked /app/velia_request_understanding.py /app/velia_request_understanding.py
COPY --from=checked /app/desktop /app/desktop
COPY --from=checked /app/services/velia_structured_output.py /app/services/velia_structured_output.py
COPY desktop/scripts/probe-live-flash.mjs /app/desktop/scripts/probe-live-flash.mjs
COPY desktop/src/config.mjs desktop/src/proxy.mjs /app/desktop/src/
USER velia
RUN node /opt/velia-qualification/harness/node_modules/@deepseek-ai/dsh/lib/bin.js --version
EXPOSE 8080
CMD ["python", "-m", "desktop.gateway"]
