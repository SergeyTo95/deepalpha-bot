{
  "info": {
    "_postman_id": "b4e8f8e1-8e0d-4b57-9072-deepalpha-api-v1",
    "name": "DeepAlpha Developer API v1",
    "description": "Quick Analysis, zero-LLM Opportunity Scan, account usage, capabilities, and HMAC-signed webhook management. Set base_url and api_key before running authenticated requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{api_key}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://your-deepalpha-host.example"
    },
    {
      "key": "api_key",
      "value": "da_test_replace_me"
    },
    {
      "key": "market_url",
      "value": "https://polymarket.com/event/example-market"
    },
    {
      "key": "webhook_url",
      "value": "https://example.com/deepalpha/webhook"
    },
    {
      "key": "analysis_job_id",
      "value": "job_replace_me"
    },
    {
      "key": "opportunity_job_id",
      "value": "job_replace_me"
    },
    {
      "key": "webhook_id",
      "value": "wh_replace_me"
    },
    {
      "key": "delivery_id",
      "value": "delivery_replace_me"
    },
    {
      "key": "webhook_signing_secret",
      "value": "whsec_replace_me"
    }
  ],
  "item": [
    {
      "name": "Documentation and health",
      "item": [
        {
          "name": "Swagger UI",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "url": "{{base_url}}/api/docs"
          }
        },
        {
          "name": "OpenAPI 3.1 JSON",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "url": "{{base_url}}/api/openapi.json"
          }
        },
        {
          "name": "Health",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "url": "{{base_url}}/api/v1/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('health responds', function () { pm.expect(pm.response.code).to.be.oneOf([200, 503]); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Account",
      "item": [
        {
          "name": "Get account",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/account"
          }
        },
        {
          "name": "Get usage",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/usage"
          }
        },
        {
          "name": "Get capabilities",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/capabilities"
          }
        }
      ]
    },
    {
      "name": "Quick Analysis",
      "item": [
        {
          "name": "Start Quick Analysis",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "analysis-{{$guid}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"market_url\": \"{{market_url}}\",\n  \"mode\": \"quick\",\n  \"language\": \"en\"\n}"
            },
            "url": "{{base_url}}/api/v1/analyses"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('accepted or idempotent replay', function () { pm.expect(pm.response.code).to.be.oneOf([200, 202]); });",
                  "const body = pm.response.json();",
                  "if (body.job_id) pm.collectionVariables.set('analysis_job_id', body.job_id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Quick Analysis",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/analyses/{{analysis_job_id}}"
          }
        }
      ]
    },
    {
      "name": "Opportunity Scan",
      "item": [
        {
          "name": "Start Opportunity Scan",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "opportunity-{{$guid}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category\": \"All\",\n  \"language\": \"en\",\n  \"scan_limit\": 100,\n  \"result_limit\": 10,\n  \"min_score\": 52,\n  \"min_liquidity\": 1000,\n  \"min_volume_24h\": 500,\n  \"tiers\": [\"DEEP_ANALYSIS_CANDIDATE\", \"WATCH_CANDIDATE\"]\n}"
            },
            "url": "{{base_url}}/api/v1/opportunity-scans"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('accepted or idempotent replay', function () { pm.expect(pm.response.code).to.be.oneOf([200, 202]); });",
                  "const body = pm.response.json();",
                  "if (body.job_id) pm.collectionVariables.set('opportunity_job_id', body.job_id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Opportunity Scan",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/opportunity-scans/{{opportunity_job_id}}"
          }
        }
      ]
    },
    {
      "name": "Signed Webhooks",
      "item": [
        {
          "name": "Create webhook",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"production\",\n  \"url\": \"{{webhook_url}}\",\n  \"events\": [\n    \"analysis.completed\",\n    \"analysis.failed\",\n    \"opportunity_scan.completed\",\n    \"opportunity_scan.failed\"\n  ]\n}"
            },
            "url": "{{base_url}}/api/v1/webhooks"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('webhook created', function () { pm.response.to.have.status(201); });",
                  "const body = pm.response.json();",
                  "if (body.webhook && body.webhook.webhook_id) pm.collectionVariables.set('webhook_id', body.webhook.webhook_id);",
                  "if (body.webhook && body.webhook.signing_secret) pm.collectionVariables.set('webhook_signing_secret', body.webhook.signing_secret);"
                ]
              }
            }
          ]
        },
        {
          "name": "List webhooks",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/webhooks"
          }
        },
        {
          "name": "Rotate webhook secret",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/webhooks/{{webhook_id}}/rotate-secret"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.webhook && body.webhook.signing_secret) pm.collectionVariables.set('webhook_signing_secret', body.webhook.signing_secret);"
                ]
              }
            }
          ]
        },
        {
          "name": "Disable webhook",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/api/v1/webhooks/{{webhook_id}}"
          }
        },
        {
          "name": "List webhook deliveries",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/webhook-deliveries?limit=50"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.deliveries && body.deliveries.length) pm.collectionVariables.set('delivery_id', body.deliveries[0].delivery_id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get webhook delivery",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/webhook-deliveries/{{delivery_id}}"
          }
        },
        {
          "name": "Retry webhook delivery",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/webhook-deliveries/{{delivery_id}}/retry"
          }
        }
      ]
    }
  ]
}
