# Gemini is fail-closed by default. Enable only after setting budget limits.
GEMINI_API_KEY=
GEMINI_ENABLED=false
GEMINI_MODEL=gemini-2.5-flash
GEMINI_DEFAULT_MAX_ATTEMPTS=1
GEMINI_ALLOW_FALLBACK_MODEL=false
GEMINI_RETRY_ON_TIMEOUT=false
GEMINI_RETRY_ON_RATE_LIMIT=false
GEMINI_RETRY_ON_SERVER_ERROR=false
GEMINI_DAILY_HTTP_ATTEMPT_LIMIT=100
GEMINI_BACKGROUND_ENABLED=false
GEMINI_BACKGROUND_DAILY_HTTP_ATTEMPT_LIMIT=0
BACKGROUND_LOCK_TTL_SECONDS=900

SIGNAL_CACHE_WORKER_ENABLED=false
SIGNAL_CACHE_GEMINI_ENABLED=false
SIGNAL_CACHE_INITIAL_DELAY_SECONDS=300
SIGNAL_CACHE_MAX_GEMINI_ATTEMPTS_PER_CYCLE=5
SIGNAL_CACHE_MAX_GEMINI_ATTEMPTS_PER_MARKET=1

WATCHLIST_WORKER_ENABLED=false
WATCHLIST_AI_SUMMARY_GEMINI_ENABLED=false
WATCHLIST_MAX_GEMINI_ATTEMPTS_PER_CYCLE=5
WATCHLIST_MAX_GEMINI_ATTEMPTS_PER_EVENT=1

NEWS_AGENT_GEMINI_ENABLED=false
DECISION_AGENT_GEMINI_ENABLED=false
SUMMARY_AGENT_GEMINI_ENABLED=false
LIVE_ANALYST_GEMINI_ENABLED=false
LIVE_ANALYST_MAX_GEMINI_ATTEMPTS_PER_REQUEST=2
LIVE_ANALYST_REPAIR_ENABLED=false
LIVE_ANALYST_VISION_GEMINI_ENABLED=false
LIVE_ANALYST_VISION_MAX_ATTEMPTS_PER_REQUEST=2
LIVE_IMAGE_SECOND_PASS_ENABLED=false
LIVE_IMAGE_CROP_EXTRACTION_ENABLED=false
LIVE_IMAGE_PER_CROP_ENABLED=false
LIVE_IMAGE_NESTED_CROP_ENABLED=false
LIVE_IMAGE_INNER_CROP_ENABLED=false
