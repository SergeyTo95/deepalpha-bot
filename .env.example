# LLM provider routing. Production stays on Gemini until explicitly changed.
LLM_PRIMARY_PROVIDER=gemini
LLM_FALLBACK_PROVIDER=none
LLM_TEXT_PROVIDER=
LLM_VISION_PROVIDER=gemini
LLM_PROVIDER_POLYMARKET=
LLM_PROVIDER_NEWS=
LLM_PROVIDER_LIVE_ANALYST=

GEMINI_ENABLED=false
GEMINI_BACKGROUND_ENABLED=false

LIVE_ANALYST_GEMINI_ENABLED=false
LIVE_ANALYST_VISION_GEMINI_ENABLED=false
LIVE_ANALYST_VISION_TOTAL_ATTEMPTS_PER_REQUEST=2
LIVE_ANALYST_VISION_MAX_ATTEMPTS_PER_CALL=1

SIGNAL_CACHE_WORKER_ENABLED=false
SIGNAL_CACHE_GEMINI_ENABLED=false
SIGNAL_CACHE_SUMMARY_GEMINI_ENABLED=false

WATCHLIST_WORKER_ENABLED=false
WATCHLIST_AI_SUMMARY_GEMINI_ENABLED=false

GEMINI_DEFAULT_MAX_ATTEMPTS=1
GEMINI_ALLOW_FALLBACK_MODEL=false
GEMINI_RETRY_ON_TIMEOUT=false
GEMINI_RETRY_ON_RATE_LIMIT=false
GEMINI_RETRY_ON_SERVER_ERROR=false

# Kimi K3 is opt-in. Never commit KIMI_API_KEY.
KIMI_ENABLED=false
KIMI_BACKGROUND_ENABLED=false
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL=kimi-k3
KIMI_REASONING_EFFORT=high
# Includes hidden K3 reasoning and the final user-visible answer.
KIMI_MAX_COMPLETION_TOKENS=8192
KIMI_MAX_COMPLETION_TOKENS_CAP=32768
# Deprecated compatibility alias. Leave empty for new deployments.
KIMI_MAX_OUTPUT_TOKENS=
KIMI_TIMEOUT_SECONDS=120
KIMI_MAX_RETRIES=1
KIMI_INPUT_USD_PER_MTOK=3.00
KIMI_CACHED_INPUT_USD_PER_MTOK=0.30
KIMI_OUTPUT_USD_PER_MTOK=15.00

# VELIA self-hosted GPU media provider. In self_hosted mode the legacy
# Fal/Reve image and BFL video submitters are not used as fallback.
VELIA_MEDIA_PROVIDER=self_hosted
VELIA_MEDIA_WORKER_BASE_URL=
VELIA_MEDIA_WORKER_AUTH_TOKEN=
VELIA_MEDIA_WORKER_JOB_TIMEOUT_SECONDS=1800
VELIA_MEDIA_WORKER_POLL_INTERVAL_SECONDS=2
VELIA_MEDIA_WORKER_HTTP_TIMEOUT_SECONDS=45
VELIA_MEDIA_WORKER_ARTIFACT_TIMEOUT_SECONDS=180
VELIA_MEDIA_WORKER_IMAGE_WIDTH=1024
VELIA_MEDIA_WORKER_IMAGE_HEIGHT=1024
# Set true only for local development against an intentionally HTTP worker.
VELIA_MEDIA_WORKER_ALLOW_HTTP=false

TON_WALLET_ENABLED=false
TON_NETWORK=mainnet
MASTER_ENCRYPTION_KEY=
TONCENTER_BASE_URL=
TONCENTER_API_KEY=
TONCENTER_MAINNET_API_KEY=
TONCENTER_TESTNET_API_KEY=

# Security hotfix controls:
# Only the dedicated Telegram bot service should set BOT_POLLING_ENABLED=true.
# WebApp and worker services must keep BOT_POLLING_ENABLED=false.
BOT_POLLING_ENABLED=false
# Keep TON_SEED_EXPORT_ENABLED=false until TON wallet incident remediation is complete.
TON_SEED_EXPORT_ENABLED=false

# Treasury emergency gates default closed for financial safety.
TREASURY_INCOMING_ENABLED=false
TREASURY_OUTGOING_ENABLED=false

# Developer API commercial launch. Every commercial gate defaults closed.
API_COMMERCIAL_LAUNCH_ENABLED=false
API_LIVE_KEYS_ENABLED=false
API_LIVE_MINIMUM_BALANCE=10
API_LIVE_ACCESS_AUTO_APPROVE_ON_PAYMENT=false

API_CREDIT_PURCHASES_ENABLED=false
# Supported launch providers: ton_treasury, manual.
# ton_treasury reuses the verified Treasury transaction scanner.
# manual never pretends that a payment was verified automatically.
API_CREDIT_INVOICE_PROVIDER=ton_treasury
API_CREDIT_CURRENCY=TON
API_CREDIT_INVOICE_TTL_HOURS=24
# Deprecated compatibility input used only when TTL_HOURS is absent.
API_CREDIT_INVOICE_TTL_MINUTES=60
API_CREDIT_MAX_OPEN_INVOICES=3
API_CREDIT_CONFIRMATION_SECONDS=20
API_LOW_BALANCE_NOTIFICATION_COOLDOWN_HOURS=24

# Manual provider settings. Do not store card data here.
API_CREDIT_PAYMENT_ADDRESS=
API_CREDIT_MANUAL_PAYMENT_INSTRUCTIONS=

# Optional JSON list. Missing packages only; administrator edits remain authoritative.
# Example: {"package_code":"starter","display_name":"Starter","credits":100,"price_amount":"0.5","price_currency":"TON","enabled":true,"sort_order":10}
API_CREDIT_PACKAGES_JSON=[]

API_COMMERCIAL_WORKER_ENABLED=true
API_COMMERCIAL_WORKER_ALLOW_PREVIEW=false
API_COMMERCIAL_POLL_SECONDS=10
API_COMMERCIAL_WORKER_STALE_SECONDS=90
API_COMMERCIAL_PRODUCTION_BRANCH=feature/turbo-short-term-btc

# VELIA Software Factory. All layers remain closed unless explicitly enabled.
VELIA_SOFTWARE_FACTORY_ENABLED=false
VELIA_SOFTWARE_FACTORY_TEAM_ENABLED=false
VELIA_SOFTWARE_FACTORY_AUTONOMY_ENABLED=false
VELIA_SOFTWARE_FACTORY_SUPERVISOR_ENABLED=false
# Controlled rollout mode: off | dry_run | live. Invalid/missing values resolve to off.
VELIA_SOFTWARE_FACTORY_ROLLOUT_MODE=off
# Comma-separated user IDs. Empty means nobody (never everybody).
VELIA_SOFTWARE_FACTORY_USER_IDS=
# Stage 4.1 multi-repo execution is a separate fail-closed gate. Even in live
# rollout it remains disabled until this flag is explicitly enabled.
VELIA_SOFTWARE_FACTORY_WORKSPACE_EXECUTION_ENABLED=false
# Supervisor cadence applies only when the corresponding supervisor is allowed.
VELIA_SOFTWARE_FACTORY_SUPERVISOR_INTERVAL_SECONDS=20
VELIA_SOFTWARE_FACTORY_SUPERVISOR_MAX_RUNS_PER_TICK=20
VELIA_SOFTWARE_FACTORY_WORKSPACE_SUPERVISOR_INTERVAL_SECONDS=20
VELIA_SOFTWARE_FACTORY_WORKSPACE_SUPERVISOR_MAX_RUNS_PER_TICK=20
