FROM postgres:16-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv \
    && rm -rf /var/lib/apt/lists/*
RUN python3 -m venv /opt/tests \
    && /opt/tests/bin/pip install --no-cache-dir pytest requests psycopg2-binary \
       python-dotenv aiohttp tonsdk cryptography pillow pypdf python-multipart
WORKDIR /app
COPY . /app
USER postgres
ENTRYPOINT ["bash", "/app/ci/verify-velia-flash.sh"]
